<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="novofluxo"/>
        <attribute name="authors" value="Pedro"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-05 09:14:20 PM"/>
        <attribute name="created" value="UGVkcm87REVTS1RPUC1NNE9CQ0hUOzIwMjYtMDUtMDU7MDU6NDU6MjIgUE07Mjg2OA=="/>
        <attribute name="edited" value="UGVkcm87REVTS1RPUC1NNE9CQ0hUOzIwMjYtMDUtMDU7MDY6MDY6NTcgUE07MTsyOTgy"/>
        <attribute name="edited" value="UGVkcm87RkVET1JBOzIwMjYtMDUtMDU7MDk6MTQ6MjAgUE07MjsyMzI4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="erro, a, b, fmin, fmax, amplitude, pontomedio" type="Real" array="False" size=""/>
            <declare name="d, numiteracoes" type="Integer" array="False" size=""/>
            <assign variable="numiteracoes" expression="0"/>
            <output expression="&quot;d: &quot;" newline="True"/>
            <input variable="d"/>
            <output expression="&quot;a: &quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;b: &quot;" newline="True"/>
            <input variable="b"/>
            <output expression="&quot;erro: &quot;" newline="True"/>
            <input variable="erro"/>
            <while expression="f(a)&lt;= d &amp;&amp; f(b)&gt;=d &amp;&amp; b-a&gt;erro">
                <assign variable="amplitude" expression="b-a"/>
                <assign variable="pontomedio" expression="amplitude/2 +a"/>
                <if expression="f(pontomedio)&gt;d">
                    <then>
                        <assign variable="b" expression="pontomedio"/>
                        <assign variable="fmax" expression="f(pontomedio)"/>
                        <assign variable="numiteracoes" expression="numiteracoes+1"/>
                    </then>
                    <else>
                        <assign variable="a" expression="pontomedio"/>
                        <assign variable="fmin" expression="f(pontomedio)"/>
                        <assign variable="numiteracoes" expression="numiteracoes+1"/>
                    </else>
                </if>
            </while>
            <if expression="numiteracoes=0">
                <then>
                    <output expression="&quot;A constante d n&#227;o interseta com a fun&#231;&#227;o OU interseta mais do que uma vez.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;N&#186; de itera&#231;&#245;es: &quot; &amp; numiteracoes" newline="True"/>
                    <output expression="&quot;Est&#225; no intervalo: [&quot; &amp; a &amp; &quot;;&quot; &amp; b &amp; &quot;]&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
    <function name="f" type="Real" variable="y">
        <parameters>
            <parameter name="x" type="Real" array="False"/>
        </parameters>
        <body>
            <declare name="y" type="Real" array="False" size=""/>
            <assign variable="y" expression="2^x-x^2"/>
        </body>
    </function>
</flowgorithm>
